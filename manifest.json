{
  "manifest_version": 3,
  "name": "__MSG_appName__",
  "version": "1.0.3",
  "version_name": "1.0.3",
  "description": "__MSG_appDesc__",
  "permissions": [
    "contextMenus",
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "__MSG_appName__",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "options/options.html",
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "commands": {
    "read-selection": {
      "suggested_key": {
        "default": "Ctrl+Shift+E",
        "mac": "MacCtrl+Shift+E"
      },
      "description": "__MSG_cmdReadSelection__"
    },
    "read-page": {
      "suggested_key": {
        "default": "Ctrl+Shift+P",
        "mac": "MacCtrl+Shift+P"
      },
      "description": "__MSG_cmdReadPage__"
    },
    "toggle-read": {
      "suggested_key": {
        "default": "Ctrl+Shift+Space",
        "mac": "MacCtrl+Shift+Space"
      },
      "description": "__MSG_cmdToggleRead__"
    },
    "stop-read": {
      "suggested_key": {
        "default": "Ctrl+Shift+S",
        "mac": "MacCtrl+Shift+S"
      },
      "description": "__MSG_cmdStopRead__"
    }
  },
  "content_scripts": [{
    "matches": ["<all_urls>"],
    "js": ["content-extractor.js", "text-utils.js", "number-normalizer.js", "reading-stats.js", "content.js"],
    "css": ["content.css"],
    "run_at": "document_idle"
  }],
  "web_accessible_resources": [
    {
      "resources": [
        "content-extractor.js",
        "text-utils.js",
        "number-normalizer.js",
        "reading-stats.js",
        "options/options.html",
        "options/options.js",
        "options/options.css",
        "_locales/*/*.json",
        "_locales/**",
        "icons/*"
      ],
      "matches": ["<all_urls>"]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "default_locale": "en"
}
